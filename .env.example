# The chatbot's Qdrant. MUST be the same instance -- this service reads the
# collections that service built, and writes in its shape.
QDRANT_URL=https://qdrant-production-efa1.up.railway.app
QDRANT_API_KEY=

# The chatbot's Postgres, read-only. Only needed so a bootstrap can look up a
# tenant's Laravel credentials; searching works without it.
DATABASE_URL=

# Bearer token callers must present. Leave empty and the service is open.
IMAGE_SEARCH_API_TOKEN=

# Must match the chatbot exactly.
SIGLIP_MODEL=google/siglip-base-patch16-224
VECTOR_SIZE=768

SEARCH_LIMIT=6
SEARCH_SCORE_THRESHOLD=0.68
SIMILAR_SCORE_THRESHOLD=0.5
MAX_UPLOAD_BYTES=12582912

# Re-embedding a tenant that already has a collection. Off, deliberately.
ALLOW_FORCE_REINDEX=false

# Indexing throughput. Lower the workers on a small box.
INDEX_WORKERS=64
INDEX_EMBED_BATCH=64
INDEX_EMBED_WORKERS=4
INDEX_MAX_IMAGES=4

# Load the model at startup rather than on the first search. Leave off where
# the platform health-checks before the weights can finish downloading.
WARMUP_ON_START=false
